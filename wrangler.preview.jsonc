{
  "name": "form-design-preview",
  "main": "src/development.js",
  "compatibility_date": "2026-11-24",
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.woff2"
      ],
      "fallthrough": true
    },
    {
      "type": "Text",
      "globs": [
        "**/*.svg",
        "**/*.css",
        "**/*.js.txt",
        "**/*.license.txt"
      ],
      "fallthrough": true
    }
  ],
  "workers_dev": true,
  "preview_urls": false
}
